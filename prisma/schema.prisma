generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
  AUDITOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  UNUSABLE
}

enum AllocationStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  INSPECTION
  ACCEPTED
  CANCELLED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  REVIEW
  CLOSED
  CANCELLED
}

enum AuditResult {
  PENDING
  VERIFIED
  MISSING
  DAMAGED
}

enum DiscrepancyStatus {
  OPEN
  CONFIRMED
  RESOLVED
}

enum Severity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  failedLogins        Int                  @default(0)
  lockedUntil         DateTime?
  employee            Employee?
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  reason       String?
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  role         Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Employee {
  id                  String               @id @default(uuid())
  userId              String               @unique
  employeeNumber      String?              @unique
  name                String
  departmentId        String?
  managerId           String?
  phone               String?
  joiningDate         DateTime?
  status              RecordStatus         @default(ACTIVE)
  user                User                 @relation(fields: [userId], references: [id])
  department          Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  manager             Employee?            @relation("EmployeeManager", fields: [managerId], references: [id])
  reports             Employee[]           @relation("EmployeeManager")
  headedDepartments   Department[]         @relation("DepartmentHead")
  allocations         Allocation[]
  transfersRequested  TransferRequest[]    @relation("TransferRequester")
  transfersProposed   TransferRequest[]    @relation("ProposedHolder")
  returns             ReturnRequest[]
  bookings            ResourceBooking[]
  maintenanceRaised   MaintenanceRequest[] @relation("MaintenanceRaised")
  maintenanceAssigned MaintenanceRequest[] @relation("MaintenanceTech")
  notifications       Notification[]
  auditAssignments    AuditAssignment[]
  auditLines          AuditLine[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([departmentId, status])
}

model Department {
  id          String            @id @default(uuid())
  name        String
  code        String            @unique
  description String?
  parentId    String?
  headId      String?
  status      RecordStatus      @default(ACTIVE)
  parent      Department?       @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[]      @relation("DepartmentTree")
  head        Employee?         @relation("DepartmentHead", fields: [headId], references: [id])
  employees   Employee[]        @relation("DepartmentEmployees")
  assets      Asset[]
  allocations Allocation[]
  bookings    ResourceBooking[]
  auditCycles AuditCycle[]

  @@index([status])
}

model AssetCategory {
  id          String                        @id @default(uuid())
  name        String
  code        String                        @unique
  description String?
  status      RecordStatus                  @default(ACTIVE)
  attributes  CategoryAttributeDefinition[]
  assets      Asset[]
}

model CategoryAttributeDefinition {
  id         String        @id @default(uuid())
  categoryId String
  name       String
  code       String
  fieldType  String
  required   Boolean       @default(false)
  options    Json?
  category   AssetCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, code])
}

model Location {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  address     String?
  status      RecordStatus @default(ACTIVE)
  assets      Asset[]
  auditCycles AuditCycle[]
}

model Asset {
  id                 String               @id @default(uuid())
  tag                String               @unique
  name               String
  serialNumber       String?
  categoryId         String
  locationId         String
  owningDepartmentId String?
  acquisitionDate    DateTime?
  acquisitionCost    Decimal?
  condition          AssetCondition       @default(GOOD)
  status             AssetStatus          @default(AVAILABLE)
  manufacturer       String?
  model              String?
  warrantyExpiry     DateTime?
  notes              String?
  shared             Boolean              @default(false)
  customAttributes   Json                 @default("{}")
  category           AssetCategory        @relation(fields: [categoryId], references: [id])
  location           Location             @relation(fields: [locationId], references: [id])
  owningDepartment   Department?          @relation(fields: [owningDepartmentId], references: [id])
  attachments        AssetAttachment[]
  histories          AssetHistory[]
  allocations        Allocation[]
  transfers          TransferRequest[]
  returns            ReturnRequest[]
  maintenance        MaintenanceRequest[]
  bookings           ResourceBooking[]
  auditLines         AuditLine[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId, status])
  @@index([locationId])
  @@index([serialNumber])
}

model AssetTagSequence {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model AssetAttachment {
  id         String   @id @default(uuid())
  assetId    String
  name       String
  mimeType   String
  size       Int
  storageKey String
  asset      Asset    @relation(fields: [assetId], references: [id])
  createdAt  DateTime @default(now())
}

model AssetHistory {
  id             String       @id @default(uuid())
  assetId        String
  previousStatus AssetStatus?
  newStatus      AssetStatus
  actorId        String?
  reason         String
  relatedType    String?
  relatedId      String?
  asset          Asset        @relation(fields: [assetId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([assetId, createdAt])
}

model Allocation {
  id                 String           @id @default(uuid())
  assetId            String
  employeeId         String?
  departmentId       String?
  status             AllocationStatus @default(ACTIVE)
  allocationDate     DateTime         @default(now())
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  purpose            String
  conditionAtIssue   AssetCondition
  accessories        String?
  notes              String?
  overdue            Boolean          @default(false)
  asset              Asset            @relation(fields: [assetId], references: [id])
  employee           Employee?        @relation(fields: [employeeId], references: [id])
  department         Department?      @relation(fields: [departmentId], references: [id])
  returns            ReturnRequest[]
  createdAt          DateTime         @default(now())

  @@index([expectedReturnDate, status])
}

model TransferRequest {
  id               String             @id @default(uuid())
  assetId          String
  requesterId      String
  proposedHolderId String
  status           TransferStatus     @default(REQUESTED)
  reason           String
  requiredBy       DateTime?
  notes            String?
  approvedById     String?
  approvedAt       DateTime?
  completedAt      DateTime?
  asset            Asset              @relation(fields: [assetId], references: [id])
  requester        Employee           @relation("TransferRequester", fields: [requesterId], references: [id])
  proposedHolder   Employee           @relation("ProposedHolder", fields: [proposedHolderId], references: [id])
  approvals        TransferApproval[]
  createdAt        DateTime           @default(now())

  @@index([status])
}

model TransferApproval {
  id         String          @id @default(uuid())
  transferId String
  approverId String
  decision   TransferStatus
  notes      String?
  transfer   TransferRequest @relation(fields: [transferId], references: [id])
  createdAt  DateTime        @default(now())
}

model ReturnRequest {
  id                  String          @id @default(uuid())
  assetId             String
  allocationId        String
  employeeId          String
  status              ReturnStatus    @default(REQUESTED)
  proposedReturnDate  DateTime?
  actualReturnDate    DateTime?
  reportedCondition   AssetCondition
  verifiedCondition   AssetCondition?
  conditionNotes      String?
  accessoriesReturned String?
  missingAccessories  String?
  newLocationId       String?
  followUpAction      String?
  asset               Asset           @relation(fields: [assetId], references: [id])
  allocation          Allocation      @relation(fields: [allocationId], references: [id])
  employee            Employee        @relation(fields: [employeeId], references: [id])
  createdAt           DateTime        @default(now())
}

model ResourceBooking {
  id            String        @id @default(uuid())
  resourceId    String
  bookedById    String
  departmentId  String?
  startTime     DateTime
  endTime       DateTime
  purpose       String
  attendeeCount Int?
  notes         String?
  status        BookingStatus @default(UPCOMING)
  resource      Asset         @relation(fields: [resourceId], references: [id])
  bookedBy      Employee      @relation(fields: [bookedById], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([resourceId, startTime, endTime])
}

model MaintenanceRequest {
  id               String            @id @default(uuid())
  assetId          String
  raisedById       String
  technicianId     String?
  issueDescription String
  priority         Priority          @default(MEDIUM)
  status           MaintenanceStatus @default(PENDING)
  approvalNotes    String?
  rejectionReason  String?
  resolutionNotes  String?
  completionDate   DateTime?
  finalCondition   AssetCondition?
  operationalCost  Decimal?
  asset            Asset             @relation(fields: [assetId], references: [id])
  raisedBy         Employee          @relation("MaintenanceRaised", fields: [raisedById], references: [id])
  technician       Employee?         @relation("MaintenanceTech", fields: [technicianId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, priority])
}

model AuditCycle {
  id           String            @id @default(uuid())
  name         String
  scopeType    String
  departmentId String?
  locationId   String?
  startDate    DateTime
  endDate      DateTime
  status       AuditStatus       @default(DRAFT)
  notes        String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  location     Location?         @relation(fields: [locationId], references: [id])
  assignments  AuditAssignment[]
  lines        AuditLine[]
  createdAt    DateTime          @default(now())

  @@index([status])
}

model AuditAssignment {
  auditId   String
  auditorId String
  audit     AuditCycle @relation(fields: [auditId], references: [id])
  auditor   Employee   @relation(fields: [auditorId], references: [id])

  @@id([auditId, auditorId])
  @@index([auditorId])
}

model AuditLine {
  id                String            @id @default(uuid())
  auditId           String
  assetId           String
  auditorId         String?
  expectedHolder    String?
  expectedLocation  String
  expectedStatus    AssetStatus
  expectedCondition AssetCondition
  result            AuditResult       @default(PENDING)
  actualLocation    String?
  actualHolder      String?
  notes             String?
  verifiedAt        DateTime?
  audit             AuditCycle        @relation(fields: [auditId], references: [id])
  asset             Asset             @relation(fields: [assetId], references: [id])
  auditor           Employee?         @relation(fields: [auditorId], references: [id])
  discrepancy       AuditDiscrepancy?

  @@unique([auditId, assetId])
}

model AuditDiscrepancy {
  id          String            @id @default(uuid())
  auditLineId String            @unique
  reason      String
  status      DiscrepancyStatus @default(OPEN)
  resolution  String?
  auditLine   AuditLine         @relation(fields: [auditLineId], references: [id])
  createdAt   DateTime          @default(now())
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  type        String
  title       String
  message     String
  severity    Severity  @default(INFO)
  readAt      DateTime?
  relatedType String?
  relatedId   String?
  dedupeKey   String?   @unique
  recipient   Employee  @relation(fields: [recipientId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
}

model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  outcome       String   @default("SUCCESS")
  reason        String?
  correlationId String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model OrganizationSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model JobRun {
  id          String   @id @default(uuid())
  jobName     String
  dedupeKey   String   @unique
  completedAt DateTime @default(now())
  result      Json?
}
