{
  "name": "assetflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/prisma/build/index.js generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/prisma/build/index.js generate && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/prisma/build/index.js generate && tsx prisma/seed.ts",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "worker": "tsx src/jobs/worker.ts",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.10.0",
    "@aws-sdk/client-s3": "3.1085.0",
    "@prisma/client": "6.14.0",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "lucide-react": "0.539.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "6.10.1",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "22.17.2",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.10",
    "prettier": "3.6.2",
    "prisma": "6.14.0",
    "tailwindcss": "4.1.12",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
